<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- コンソールの回線種別・VPN 状態の表示に使う。通常権限なので実行時確認は不要 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Web Insights のアプリ別通信量に使う。signature|appop なので実行時ダイアログでは出せず、
      ここで宣言したうえでユーザーが設定 →「使用状況へのアクセス」で許可する。
      未許可でもアプリは通常どおり動き、Insights ペインだけが空になる。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      起動可能アプリの可視性。Android 11 以降はこれが無いと一覧が空になる。
      QUERY_ALL_PACKAGES は使わない（Play のポリシー宣言が不要な範囲で足りる）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 既定ホームアプリの判定に HOME インテントを解決するため -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".ZLauncherApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustPan"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.ZLauncher">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ログ CSV の書き出し先。cacheDir だけを、一時的な read 権限で渡す -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.insights"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/insights_paths" />
        </provider>
    </application>
</manifest>
