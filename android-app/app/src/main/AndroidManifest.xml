<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- コンソールの回線種別・VPN 状態の表示に使う。通常権限なので実行時確認は不要 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- URL カテゴリー一覧（Zscaler ヘルプの CSV）を 3 か月ごとに取り直すためだけに使う -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- カタログに変更があったときの通知。Android 13 以降は実行時の許可も要る -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Web Insights のアプリ別通信量に使う。signature|appop なので実行時ダイアログでは出せず、
      ここで宣言したうえでユーザーが設定 →「使用状況へのアクセス」で許可する。
      未許可でもアプリは通常どおり動き、Insights ペインだけが空になる。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      認証コードの QR を読むためだけに使う。実行時に確認を取り、断られても貼り付けと
      手入力で登録できる。写した絵はどこにも保存しない。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- カメラの無い端末でも入る（読み取り以外は全部動く） -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      起動可能アプリの可視性。Android 11 以降はこれが無いと一覧が空になる。
      QUERY_ALL_PACKAGES は使わない（Play のポリシー宣言が不要な範囲で足りる）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 既定ホームアプリの判定に HOME インテントを解決するため -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- ウィジェット提供元アプリ。ランチャーアイコンを持たない提供元もあるので、
             これが無いと一覧に提供元アプリ名を出せない（検索も効かなくなる） -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".ZLauncherApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustPan"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.ZLauncher">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ホーム画面に置く認証コード。1 つの登録につき 1 枚（TotpWidgetConfigActivity で
          どの登録を映すか決める）。exported="true" はウィジェットの受け口として必須なので、
          ここで受けるのはシステムからの APPWIDGET_* だけにしてある。
        -->
        <receiver
            android:name=".ui.widgets.totp.TotpWidgetProvider"
            android:exported="true"
            android:label="@string/totp_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/totp_widget_info" />
        </receiver>

        <!--
          タップとアラームの受け口。こちらは非公開でよい（PendingIntent はこのアプリの
          権限で送られる）。提供元と分けているのは、提供元が公開必須で、そこに自前の
          action を足すと他アプリからコードを出させられるため。
        -->
        <receiver
            android:name=".ui.widgets.totp.TotpWidgetActionReceiver"
            android:exported="false" />

        <!--
          どの登録を映すか選ぶ画面。ウィジェットの設定 Activity はホスト（ランチャー）から
          起動されるので exported="true" が要る。ウィジェット id が渡らない呼び出しでは
          一覧を出さずにそのまま閉じる。
        -->
        <activity
            android:name=".ui.widgets.totp.TotpWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ZLauncher.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          WorkManager の自動初期化を止める。Hilt のファクトリを Application 側から渡すため。
          残したままだと Worker への注入ができず、生成時に落ちる。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ログ CSV の書き出し先。cacheDir だけを、一時的な read 権限で渡す -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.insights"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/insights_paths" />
        </provider>
    </application>
</manifest>
