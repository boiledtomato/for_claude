<!--
  ランチャー自身のアイコン。アプリの見た目（ダークなコンソール）に合わせて、
  角丸の枠 + 生きている線、という構図にする。
  Adaptive Icon の可視領域（108 のうち中央 66〜72）に収める。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- コンソールの枠 -->
    <path
        android:pathData="M34,29 L74,29 A7,7 0 0 1 81,36 L81,72 A7,7 0 0 1 74,79 L34,79 A7,7 0 0 1 27,72 L27,36 A7,7 0 0 1 34,29 Z"
        android:fillColor="#00000000"
        android:strokeColor="#2E7DF6"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round" />

    <!-- 上端のバー（ヘッダを示す） -->
    <path
        android:pathData="M27,41 L81,41"
        android:fillColor="#00000000"
        android:strokeColor="#2E7DF6"
        android:strokeWidth="3"
        android:strokeAlpha="0.55" />

    <!-- 実測値の線 -->
    <path
        android:pathData="M36,68 L47,56 L56,63 L72,47"
        android:fillColor="#00000000"
        android:strokeColor="#22D3EE"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 最新値のドット -->
    <path
        android:pathData="M72,47 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0"
        android:fillColor="#22D3EE" />
</vector>
