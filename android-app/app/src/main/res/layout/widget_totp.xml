<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面に置く認証コード 1 件分。

  ウィジェットは RemoteViews なので Compose は使えない。色はここでは決めず、
  TotpWidgetRenderer が配色トークンから流し込む（アプリ側で明暗を固定できるため、
  -night リソースでは利用者の選択とずれる）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_totp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_totp_issuer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_totp_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_totp_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:textSize="24sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="13sp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeStepGranularity="1sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Chronometer
            android:id="@+id/widget_totp_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_totp_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
