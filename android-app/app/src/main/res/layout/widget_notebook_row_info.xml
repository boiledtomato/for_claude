<?xml version="1.0" encoding="utf-8"?>
<!--
  情報の行。公開されている項目だけを出す ― 題・絵文字・権限・共有の有無・最後に見た日時。

  **ソース件数は出せない。** 数える API が公開されていないので、出すなら 0 固定の嘘になる。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="28dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_emoji"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="1dp"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
    </LinearLayout>

    <!--
      行の下の罫線。実線 / 破線 / 点線はどれもベクターで、実行時に
      setImageViewResource で差し替える（NONE のときは visibility=gone）。
      高さは 1dp 固定、幅いっぱいに伸ばす。
    -->
    <ImageView
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
